{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^(macro|automacro|call)\\s+\\w+\\s*{",
      "end": "^}"
    }
  },
  "wordPattern": "(\\$\\.[a-zA-Z_][\\w]*)|(&[a-zA-Z_][\\w]*)|([a-zA-Z_][\\w]*)"
}
