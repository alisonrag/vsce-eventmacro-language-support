{
  "If Statement": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "  $0", "}"],
    "description": "If statement",
  },
  "While Loop": {
    "prefix": "while",
    "body": ["while (${1:condition}) {", "  $0", "}"],
    "description": "While loop",
  },
  "For Loop": {
    "prefix": "for",
    "body": ["for (${1:i} = ${2:0}; ${1} < ${3:count}; ${1}++) {", "  $0", "}"],
    "description": "For loop",
  },
  "Goto Statement": {
    "prefix": "goto",
    "body": ["goto ${1:label};"],
    "description": "Goto statement",
  },
  "Automacro Definition": {
    "prefix": "automacro",
    "body": [
      "automacro ${1:name} {",
      "  ${2:condition}",
      "  call ${3:macro}",
      "}",
    ],
    "description": "Automacro block",
  },
  "Automacro Call": {
    "prefix": "automacrocall",
    "body": [
      "automacro ${1:name} {",
      "  ${2:condition}",
      "  call {",
      "  }",
      "}",
    ],
    "description": "Call an automacro",
  },
  "Macro Definition": {
    "prefix": "macro",
    "body": ["macro ${1:name} {", "  $0", "}"],
    "description": "Macro definition",
  },
  "Sub Definition": {
    "prefix": "sub",
    "body": ["sub ${1:name} {", "  $0", "}"],
    "description": "Subroutine definition",
  },
}
